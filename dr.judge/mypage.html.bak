<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>Dr.Judge · 마이페이지</title>
    <link rel="stylesheet" href="common.css" />
    <link rel="stylesheet" href="tabs.css" />
    <link rel="stylesheet" href="feed.css" />
    <link rel="stylesheet" href="result.css" />
    <link rel="stylesheet" href="mypage.css" />
  </head>
  <body>
    <div class="app tabpage mypage">
      <header class="mypage__head">
        <h1 class="mypage__title">마이페이지</h1>

        <div class="settingmenu" id="settingMenu">
          <button type="button" class="mypage__gear" id="settingBtn" aria-label="설정" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3.1" />
              <path d="M19.1 14.4a1.5 1.5 0 0 0 .3 1.7l.1.1a1.8 1.8 0 1 1-2.6 2.6l-.1-.1a1.5 1.5 0 0 0-1.7-.3 1.5 1.5 0 0 0-.9 1.4v.3a1.8 1.8 0 1 1-3.6 0v-.2a1.5 1.5 0 0 0-1-1.4 1.5 1.5 0 0 0-1.7.3l-.1.1a1.8 1.8 0 1 1-2.6-2.6l.1-.1a1.5 1.5 0 0 0 .3-1.7 1.5 1.5 0 0 0-1.4-.9h-.3a1.8 1.8 0 1 1 0-3.6h.2a1.5 1.5 0 0 0 1.4-1 1.5 1.5 0 0 0-.3-1.7l-.1-.1a1.8 1.8 0 1 1 2.6-2.6l.1.1a1.5 1.5 0 0 0 1.7.3h.1a1.5 1.5 0 0 0 .9-1.4v-.3a1.8 1.8 0 1 1 3.6 0v.2a1.5 1.5 0 0 0 .9 1.4 1.5 1.5 0 0 0 1.7-.3l.1-.1a1.8 1.8 0 1 1 2.6 2.6l-.1.1a1.5 1.5 0 0 0-.3 1.7v.1a1.5 1.5 0 0 0 1.4.9h.3a1.8 1.8 0 1 1 0 3.6h-.2a1.5 1.5 0 0 0-1.4.9Z" />
            </svg>
          </button>

          <ul class="settingmenu__list" id="settingList" hidden>
            <li>
              <button type="button" class="settingmenu__item" id="logoutBtn">
                로그아웃
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 20H6a1.5 1.5 0 0 1-1.5-1.5v-13A1.5 1.5 0 0 1 6 4h8" />
                  <path d="M16.5 15.5 20 12l-3.5-3.5M20 12H9.5" />
                </svg>
              </button>
            </li>
            <li>
              <button type="button" class="settingmenu__item settingmenu__item--danger" id="withdrawBtn">
                회원탈퇴
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 7h14M10 7V5h4v2M7 7l1 12h8l1-12" />
                </svg>
              </button>
            </li>
          </ul>
        </div>
      </header>

      <section class="profile2">
        <img
          class="profile2__avatar"
          src="./assets/character.png"
          alt=""
          data-fallback="character"
        />
        <div class="profile2__info">
          <p class="profile2__name" id="myNickname">마라탕후루이비똥</p>
          <a href="./profile-edit.html" class="profile2__edit">내 정보 수정</a>
        </div>
      </section>

      <nav class="mtabs" id="myTabs">
        <button type="button" class="mtabs__item is-active" data-tab="point">포인트</button>
        <button type="button" class="mtabs__item" data-tab="history">판정 이력</button>
        <button type="button" class="mtabs__item" data-tab="cards">나의 공유 카드</button>
      </nav>

      <div class="scroll-area">
        <!-- 포인트 -->
        <section class="mpanel" data-panel="point">
          <div class="pointcard">
            <p class="pointcard__label">누적 포인트</p>
            <p class="pointcard__value" id="pointValue">불러오는 중…</p>
            <button type="button" class="pointcard__more" id="pointAll">포인트 내역 ›</button>
            <span class="pointcard__coin" aria-hidden="true">P</span>
          </div>

          <h2 class="mpanel__title" id="pointLogTitle">포인트 내역</h2>
          <ul class="pointlog" id="pointLog"></ul>
          <button type="button" class="morebtn" id="pointMore" hidden>더 보기</button>

          <p class="pointnote">
            <span class="pointnote__coin" aria-hidden="true">P</span>
            포인트는 1P부터 사용 가능해요!
          </p>
        </section>

        <!-- 판정 이력 -->
        <section class="mpanel" data-panel="history" hidden>
          <div class="mpanel__head">
            <h2 class="mpanel__title">판정 이력</h2>
            <button type="button" class="mini-select" id="historyFilter">전체 ▾</button>
          </div>

          <div class="statrow" id="statRow"></div>
          <ul class="historylist" id="historyList"></ul>
          <button type="button" class="morebtn" id="historyMore" hidden>더 보기</button>
        </section>

        <!-- 나의 공유 카드 -->
        <section class="mpanel" data-panel="cards" hidden>
          <div class="mpanel__head">
            <h2 class="mpanel__title">나의 공유 카드 <span id="cardCount">0</span>개</h2>
            <button type="button" class="mini-select" id="cardSort">최신순 ▾</button>
          </div>
          <ul class="mycards" id="myCards"></ul>
          <button type="button" class="morebtn" id="cardsMore" hidden>더 보기</button>
        </section>
      </div>

      <nav class="tabbar" data-active="my"></nav>

      <!-- 게시물 삭제 확인 -->
      <div class="confirm" id="revokeConfirm" hidden>
        <div class="confirm__box" role="alertdialog" aria-labelledby="revokeTitle">
          <h2 class="confirm__title" id="revokeTitle">게시물을 내릴까요?</h2>
          <p class="confirm__desc">
            공유 피드에서 사라집니다.
            판정 결과는 내 판정 이력에 그대로 남아요.
          </p>
          <p class="form-alert" id="revokeAlert" hidden></p>
          <div class="confirm__actions">
            <button type="button" class="confirm__btn confirm__btn--cancel" id="revokeCancel">취소</button>
            <button type="button" class="confirm__btn confirm__btn--danger" id="revokeOk">삭제하기</button>
          </div>
        </div>
      </div>

      <!-- 회원탈퇴 확인 -->
      <div class="confirm" id="withdrawConfirm" hidden>
        <div class="confirm__box" role="alertdialog" aria-labelledby="withdrawTitle">
          <h2 class="confirm__title" id="withdrawTitle">정말 탈퇴할까요?</h2>
          <p class="confirm__desc">
            판정 이력, 포인트, 공유한 카드가 모두 사라지고
            <b>되돌릴 수 없어요.</b>
          </p>
          <p class="form-alert" id="withdrawAlert" hidden></p>
          <div class="confirm__actions">
            <button type="button" class="confirm__btn confirm__btn--cancel" id="withdrawCancel">취소</button>
            <button type="button" class="confirm__btn confirm__btn--danger" id="withdrawOk">탈퇴하기</button>
          </div>
        </div>
      </div>

      <!-- 로그아웃 확인 -->
      <div class="confirm" id="logoutConfirm" hidden>
        <div class="confirm__box" role="alertdialog" aria-labelledby="logoutTitle">
          <h2 class="confirm__title" id="logoutTitle">로그아웃할까요?</h2>
          <p class="confirm__desc">
            로그아웃해도 판정 이력과 포인트는 그대로 보관돼요.
            다시 로그인하면 이어서 볼 수 있습니다.
          </p>
          <div class="confirm__actions">
            <button type="button" class="confirm__btn confirm__btn--cancel" id="logoutCancel">취소</button>
            <button type="button" class="confirm__btn confirm__btn--ok" id="logoutOk">로그아웃</button>
          </div>
        </div>
      </div>
    </div>

    <script src="common.js"></script>
    <script src="data.js"></script>
    <script src="store.js"></script>
    <script src="api.js"></script>
    <script src="mypage.js"></script>
  </body>
</html>
