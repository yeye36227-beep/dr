<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>Dr.Judge · 판정</title>
    <link rel="stylesheet" href="common.css" />
    <link rel="stylesheet" href="home.css" />
    <link rel="stylesheet" href="tabs.css" />
    <link rel="stylesheet" href="judge.css" />
    <link rel="stylesheet" href="mypage.css" />
  </head>
  <body>
    <div class="app tabpage">
      <header class="pagehead">
        <h1 class="pagehead__title">판정</h1>
      </header>

      <div class="scroll-area">
        <!-- 판정 요청 카드 -->
        <section class="judgebox">
          <img
            class="judgebox__char"
            src="./assets/character.png"
            alt=""
            data-fallback="character"
          />
          <div class="judgebox__body">
            <h2 class="judgebox__title">궁금한 건강 정보,<br />사실인지 판정해 드려요</h2>
            <p class="judgebox__desc">문장이나 링크를 붙여넣어 보세요.</p>
          </div>
        </section>

        <section class="entry">
          <a href="./judge-text.html" class="entry__item">
            <span class="entry__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <path d="M5 6h14M5 11h14M5 16h9" />
              </svg>
            </span>
            <span class="entry__text">
              <b>텍스트로 판정 요청</b>
              <span>문장을 붙여넣거나 직접 입력</span>
            </span>
            <span class="entry__arrow" aria-hidden="true"></span>
          </a>

          <a href="./judge-image.html" class="entry__item">
            <span class="entry__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3.5" y="5" width="17" height="14" rx="2.5" />
                <path d="m5 17 4.5-5 3 3.5L16 12l3 4" />
                <circle cx="9" cy="9.5" r="1.4" />
              </svg>
            </span>
            <span class="entry__text">
              <b>이미지로 판정 요청</b>
              <span>사진·스크린샷 업로드</span>
            </span>
            <span class="entry__arrow" aria-hidden="true"></span>
          </a>

          <a href="./judge-link.html" class="entry__item">
            <span class="entry__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <path d="M10 14a4 4 0 0 0 5.7 0l2.8-2.8a4 4 0 0 0-5.7-5.7L11.5 6.8" />
                <path d="M14 10a4 4 0 0 0-5.7 0L5.5 12.8a4 4 0 0 0 5.7 5.7l1.3-1.3" />
              </svg>
            </span>
            <span class="entry__text">
              <b>링크로 판정 요청</b>
              <span>유튜브·SNS 링크 붙여넣기</span>
            </span>
            <span class="entry__arrow" aria-hidden="true"></span>
          </a>
        </section>

        <!-- 최근 판정 기록 -->
        <section class="section">
          <div class="section__head">
            <h2 class="section__title">최근 판정</h2>
            <a href="./mypage.html" class="section__more">전체보기 ›</a>
          </div>
          <ul class="judgelist" id="judgeList"><!-- JS 렌더 --></ul>
        </section>
      </div>

      <nav class="tabbar" data-active="judge"></nav>
    </div>

    <script src="common.js"></script>
    <script src="store.js"></script>
    <script src="data.js"></script>
    <script src="judge.js"></script>
  </body>
</html>
